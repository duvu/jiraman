{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "outcome",
    "context",
    "in_scope",
    "out_of_scope",
    "requirements",
    "acceptance_criteria",
    "constraints",
    "nonfunctional_requirements",
    "dependencies",
    "validation",
    "rollout",
    "recovery",
    "unresolved_decisions"
  ],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "in_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "source_section"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_section": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "source_section"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_section": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonfunctional_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rollout": {
      "type": "string"
    },
    "recovery": {
      "type": "string"
    },
    "unresolved_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
