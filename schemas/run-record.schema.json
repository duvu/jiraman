{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "command_mode",
    "started_at",
    "ended_at",
    "capability_health",
    "tool_results",
    "action_ids",
    "verification_result",
    "artifact_refs"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "command_mode": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "capability_health": {
      "enum": [
        "healthy",
        "degraded",
        "blocked"
      ]
    },
    "tool_results": {
      "type": "array",
      "items": {
        "enum": [
          "success",
          "tool-failure",
          "missing-evidence",
          "policy-rejection",
          "stale-action",
          "verification-failure"
        ]
      }
    },
    "action_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PM[AG]-[0-9]{8}-[0-9]{2}$"
      }
    },
    "verification_result": {
      "enum": [
        "passed",
        "failed",
        "not-applicable",
        "not-verified"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$id": "https://duvu.github.io/jiraman/schemas/run-record.schema.json"
}
