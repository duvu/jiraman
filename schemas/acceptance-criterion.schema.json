{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://duvu.github.io/jiraman/schemas/acceptance-criterion.schema.json",
  "definitions": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "verification"],
      "properties": {
        "id": {"type": "string", "pattern": "^AC-[0-9]+$"},
        "statement": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "verification": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "goal-criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "verification", "requirement_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^AC-[0-9]+$"},
        "statement": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "verification": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "requirement_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^REQ-[0-9]+$"}
        }
      }
    },
    "subtask-criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "verification", "validation_ref", "definition_of_done_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^AC-[0-9]+$"},
        "statement": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "verification": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "validation_ref": {"const": "VAL-1"},
        "definition_of_done_ref": {"const": "DOD-1"}
      }
    },
    "source-criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "verification", "requirement_refs", "source_section"],
      "properties": {
        "id": {"type": "string", "pattern": "^AC-[0-9]+$"},
        "statement": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "verification": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "requirement_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^REQ-[0-9]+$"}
        },
        "source_section": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    }
  }
}
