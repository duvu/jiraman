{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://duvu.github.io/jiraman/schemas/config.schema.json",
  "anyOf": [{"$ref": "#/definitions/v5"}, {"$ref": "#/definitions/v6"}],
  "definitions": {
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jira_ticket_content", "user_response"],
      "properties": {
        "jira_ticket_content": {"type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"},
        "user_response": {"type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"},
        "mcp_schema_and_query": {"const": "preserve"},
        "explicit_override_allowed": {"const": true},
        "existing_ticket_mode": {"const": "preserve-human-content"},
        "preserved_literal_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "preserved_technical_terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "compatLanguage": {
      "allOf": [
        {"$ref": "#/definitions/language"},
        {"type": "object", "required": ["jira_ticket_content", "user_response"], "properties": {"jira_ticket_content": {"const": "vi-VN"}, "user_response": {"const": "vi-VN"}}}
      ]
    },
    "confluence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_space_keys", "page_roots"],
      "properties": {
        "allowed_space_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]+$"}},
        "page_roots": {"type": "object", "additionalProperties": {"type": ["string", "null"]}}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": true,
      "required": ["hierarchy", "story_semantics", "minimum_goal_stories_per_epic", "minimum_subtasks_per_goal", "maximum_subtask_hours", "required_goal_fields"],
      "properties": {
        "hierarchy": {"const": ["Epic", "Story", "Sub-task"]},
        "story_semantics": {"const": "goal"},
        "minimum_goal_stories_per_epic": {"type": "integer", "minimum": 2},
        "minimum_subtasks_per_goal": {"type": "integer", "minimum": 2},
        "maximum_subtask_hours": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
        "required_goal_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_or_nothing_preflight", "read_before_write", "read_after_write"],
      "properties": {
        "group_prefix": {"const": "PMG"},
        "action_prefix": {"const": "PMA"},
        "ttl_hours": {"type": "integer", "minimum": 1},
        "all_or_nothing_preflight": {"const": true},
        "read_before_write": {"const": true},
        "read_after_write": {"const": true}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {"path": {"const": ".kilo/state/jiraman.json"}, "run_retention_days": {"type": "integer", "minimum": 1}}
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "aliases", "jira_project_key", "confluence", "timezone", "sprint_length_days", "language", "delivery", "profile_revision"],
      "properties": {
        "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"}},
        "jira_project_key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$"},
        "confluence": {"$ref": "#/definitions/confluence"},
        "timezone": {"type": "string", "minLength": 1},
        "sprint_length_days": {"type": "integer", "minimum": 1},
        "language": {"$ref": "#/definitions/language"},
        "delivery": {"$ref": "#/definitions/delivery"},
        "profile_revision": {"type": "integer", "minimum": 1}
      }
    },
    "repositoryMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id"],
      "properties": {"project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"}, "repository_root": {"type": "string", "minLength": 1}, "git_remote": {"type": "string", "minLength": 1}},
      "anyOf": [{"required": ["repository_root"], "properties": {"repository_root": {"type": "string", "minLength": 1}}}, {"required": ["git_remote"], "properties": {"git_remote": {"type": "string", "minLength": 1}}}]
    },
    "v5": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "project", "language", "confluence", "delivery", "actions", "state"],
      "properties": {
        "schema_version": {"const": 5},
        "project": {"type": "object", "additionalProperties": false, "required": ["key", "timezone", "sprint_length_days"], "properties": {"key": {"const": "AIPLATFORM"}, "timezone": {"type": "string", "minLength": 1}, "sprint_length_days": {"type": "integer", "minimum": 1}}},
        "language": {"$ref": "#/definitions/compatLanguage"},
        "confluence": {"$ref": "#/definitions/confluence"},
        "delivery": {"$ref": "#/definitions/delivery"},
        "actions": {"$ref": "#/definitions/actions"},
        "state": {"$ref": "#/definitions/state"}
      }
    },
    "v6": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "default_project_id", "profiles", "repository_mappings", "actions", "state"],
      "properties": {
        "schema_version": {"const": 6},
      "default_project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
        "project": {"type": "object", "additionalProperties": false, "required": ["key", "timezone", "sprint_length_days"], "properties": {"key": {"const": "AIPLATFORM"}, "timezone": {"type": "string", "minLength": 1}, "sprint_length_days": {"type": "integer", "minimum": 1}}},
        "profiles": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[a-z][a-z0-9-]{1,31}$"}, "additionalProperties": {"$ref": "#/definitions/profile"}},
        "repository_mappings": {"type": "array", "items": {"$ref": "#/definitions/repositoryMapping"}},
        "actions": {"$ref": "#/definitions/actions"},
        "state": {"$ref": "#/definitions/state"},
        "language": {"$ref": "#/definitions/compatLanguage"},
        "confluence": {"$ref": "#/definitions/confluence"},
        "delivery": {"$ref": "#/definitions/delivery"}
      }
    }
  }
}
