{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "epic",
    "stories"
  ],
  "properties": {
    "epic": {
      "type": "object",
      "required": [
        "disposition",
        "outcome",
        "value_problem",
        "in_scope",
        "out_of_scope",
        "success_measures",
        "constraints",
        "dependencies",
        "risks",
        "story_map",
        "exit_criteria",
        "blocking_gaps"
      ],
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "reuse",
            "update",
            "create"
          ]
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "key": {"type": "string", "pattern": "^AIPLATFORM-[0-9]+$"},
        "draft_ref": {"type": "string", "minLength": 1},
        "value_problem": {"type": "string", "minLength": 1},
        "in_scope": {"type": "array", "minItems": 1},
        "out_of_scope": {"type": "array"},
        "success_measures": {"type": "array", "minItems": 1},
        "constraints": {"type": "array"},
        "dependencies": {"type": "array"},
        "risks": {"type": "array"},
        "story_map": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "exit_criteria": {"type": "array", "minItems": 1},
        "blocking_gaps": {"type": "array"}
      }
    },
    "stories": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "draft_ref",
          "disposition",
          "goal_name",
          "target_completion_date",
          "target_completion_date_evidence",
          "definition_of_done",
          "outcome",
          "canonical_spec",
          "context",
          "in_scope",
          "out_of_scope",
          "requirements",
          "acceptance_criteria",
          "constraints",
          "dependencies",
          "validation",
          "rollout",
          "recovery",
          "estimate_basis",
          "blocking_gaps"
        ],
        "properties": {
          "draft_ref": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {"enum": ["create", "update", "reuse"]},
          "existing_key": {"type": "string", "pattern": "^AIPLATFORM-[0-9]+$"},
          "goal_name": {
            "type": "string",
            "minLength": 1
          },
          "target_completion_date": {
            "type": "string",
            "format": "date"
          },
          "target_completion_date_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "reference", "verified"],
            "properties": {
              "source": {
                "enum": ["sprint-end", "milestone", "specification", "explicit-user-decision"]
              },
              "reference": {"type": "string", "minLength": 1},
              "verified": {"const": true}
            }
          },
          "definition_of_done": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "canonical_spec": {"type": "string", "minLength": 1},
          "context": {"type": "string", "minLength": 1},
          "in_scope": {
            "type": "array",
            "minItems": 1
          },
          "out_of_scope": {
            "type": "array"
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "pattern": "^REQ-[0-9]+$",
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "pattern": "^AC-[0-9]+$",
              "type": "string"
            }
          },
          "constraints": {
            "type": "array"
          },
          "dependencies": {
            "type": "array"
          },
          "validation": {
            "type": "array",
            "minItems": 1
          },
          "rollout": {"type": "string", "minLength": 1},
          "recovery": {"type": "string", "minLength": 1},
          "estimate_basis": {
            "type": "string",
            "minLength": 1
          },
          "blocking_gaps": {
            "type": "array"
          }
        }
      }
    }
  }
}
