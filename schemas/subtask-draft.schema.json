{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "story_ref",
    "goal",
    "subtasks",
    "traceability"
  ],
  "properties": {
    "story_ref": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_name",
        "target_completion_date",
        "definition_of_done"
      ],
      "properties": {
        "goal_name": {"type": "string", "minLength": 1},
        "target_completion_date": {"type": "string", "format": "date"},
        "definition_of_done": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "subtasks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "draft_ref",
          "title",
          "outcome",
          "in_scope",
          "out_of_scope",
          "steps",
          "affected_files",
          "dependencies",
          "validation",
          "definition_of_done",
          "estimate_hours",
          "requirements",
          "acceptance_criteria"
        ],
        "properties": {
          "draft_ref": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "in_scope": {
            "type": "array",
            "minItems": 1
          },
          "out_of_scope": {
            "type": "array"
          },
          "steps": {
            "type": "array",
            "minItems": 1
          },
          "affected_files": {
            "type": "array"
          },
          "dependencies": {
            "type": "array"
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "definition_of_done": {
            "type": "string",
            "minLength": 1
          },
          "estimate_hours": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 4
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "pattern": "^REQ-[0-9]+$",
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "pattern": "^AC-[0-9]+$",
              "type": "string"
            }
          }
        }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "acceptance_criteria",
        "goal_definition_of_done"
      ],
      "properties": {
        "requirements": {"$ref": "#/definitions/traceability-map"},
        "acceptance_criteria": {"$ref": "#/definitions/traceability-map"},
        "goal_definition_of_done": {"$ref": "#/definitions/traceability-map"}
      }
    }
  },
  "definitions": {
    "traceability-map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    }
  }
}
