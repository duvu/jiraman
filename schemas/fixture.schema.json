    "kind",
    "metadata",
    "expected",
    "data"
  ],
  "properties": {
    "fixture_version": {
      "const": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "version",
        "sanitized",
        "semantic_capability"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sanitized": {
          "const": true
        },
        "semantic_capability": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expected": {
      "type": "object"
    },
    "data": {}
  }
}
