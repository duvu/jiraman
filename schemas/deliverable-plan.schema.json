{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidates",
    "scenarios",
    "recommendation",
    "displaced_work",
    "page_proposal"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "outcome",
          "primary_epic",
          "stories",
          "goals",
          "target_sprint",
          "target_sprint_end",
          "week_1_outcome",
          "week_2_outcome",
          "acceptance_signal",
          "rationale",
          "evidence",
          "assumptions",
          "hypotheses",
          "readiness",
          "capacity_fit",
          "dependencies",
          "wip_impact",
          "risk",
          "confidence"
        ],
        "properties": {
          "id": {
            "pattern": "^DLV-[0-9]{8}-[0-9]{2}$",
            "type": "string"
          },
          "class": {
            "enum": [
              "Ready-backed",
              "Refinement candidate",
              "New hypothesis",
              "Excluded"
            ]
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "primary_epic": {
            "type": "string",
            "minLength": 1
          },
          "stories": {
            "type": "array",
            "minItems": 1
          },
          "goals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "story_ref",
                "goal_name",
                "target_completion_date",
                "definition_of_done",
                "epic_parent",
                "readiness",
                "subtasks",
                "traceability_complete",
                "deadline_exception_approved"
              ],
              "properties": {
                "story_ref": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"},
                "goal_name": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"},
                "target_completion_date": {"type": ["string", "null"], "format": "date"},
                "target_completion_date_evidence": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source", "reference", "verified"],
                  "properties": {
                    "source": {"enum": ["sprint-end", "milestone", "specification", "explicit-user-decision"]},
                    "reference": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"},
                    "verified": {"const": true}
                  }
                },
                "definition_of_done": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"}
                },
                "canonical_spec": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"},
                "requirements": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^REQ-[0-9]+$"}
                },
                "acceptance_criteria": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "https://duvu.github.io/jiraman/schemas/acceptance-criterion.schema.json#/definitions/goal-criterion"}
                },
                "epic_parent": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"},
                "readiness": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"},
                "subtasks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["ref", "estimate_hours"],
                    "properties": {
                      "ref": {"type": "string", "minLength": 1},
                      "summary": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"},
                      "outcome": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"},
                      "in_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"}},
                      "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"}},
                      "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"}},
                      "affected_files": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"}},
                      "validation": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"},
                      "definition_of_done": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"},
                      "dependencies": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*[\\p{Default_Ignorable_Code_Point}\\p{Cc}])(?=[\\s\\S]*[\\p{L}\\p{N}])"}
                      },
                      "estimate_hours": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
                      "requirements": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {"type": "string", "pattern": "^REQ-[0-9]+$"}
                      },
                      "parent_acceptance_criteria_refs": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {"type": "string", "pattern": "^AC-[0-9]+$"}
                      },
                      "content_language": {"const": "vi-VN"},
                      "acceptance_criteria_storage": {"const": "managed-description-section"},
                      "acceptance_criteria": {
                        "type": "array",
                        "minItems": 1,
                        "items": {"$ref": "https://duvu.github.io/jiraman/schemas/acceptance-criterion.schema.json#/definitions/subtask-criterion"}
                      }
                    }
                  }
                },
                "traceability": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["requirements", "acceptance_criteria", "goal_definition_of_done"],
                  "properties": {
                    "requirements": {"$ref": "#/definitions/traceability-map"},
                    "acceptance_criteria": {"$ref": "#/definitions/traceability-map"},
                    "goal_definition_of_done": {"$ref": "#/definitions/traceability-map"}
                  }
                },
                "traceability_complete": {"type": "boolean"},
                "deadline_exception_approved": {"type": "boolean"}
              }
            }
          },
          "target_sprint": {
            "enum": [
              "N+1",
              "N+2"
            ]
          },
          "target_sprint_end": {
            "type": "string",
            "format": "date"
          },
          "week_1_outcome": {
            "type": "string",
            "minLength": 1
          },
          "week_2_outcome": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_signal": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array"
          },
          "assumptions": {
            "type": "array"
          },
          "hypotheses": {
            "type": "array"
          },
          "readiness": {
            "type": "string"
          },
          "capacity_fit": {
            "type": "string"
          },
          "dependencies": {
            "type": "array"
          },
          "wip_impact": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "not verified"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"class": {"const": "Ready-backed"}},
              "required": ["class"]
            },
            "then": {
              "properties": {
                "readiness": {"const": "ready"},
                "capacity_fit": {"const": "verified"},
                "goals": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "story_ref": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}-[0-9]+$"},
                      "epic_parent": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}-[0-9]+$"},
                      "target_completion_date": {"type": "string", "format": "date"},
                      "target_completion_date_evidence": true,
                      "definition_of_done": {"type": "array", "minItems": 1, "uniqueItems": true},
                      "canonical_spec": true,
                      "requirements": true,
                      "acceptance_criteria": true,
                      "subtasks": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "type": "object",
                          "required": ["ref", "summary", "outcome", "in_scope", "out_of_scope", "steps", "affected_files", "validation", "definition_of_done", "dependencies", "estimate_hours", "requirements", "parent_acceptance_criteria_refs", "content_language", "acceptance_criteria_storage", "acceptance_criteria"],
                          "properties": {
                            "ref": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}-[0-9]+$"},
                            "summary": true,
                            "outcome": true,
                            "in_scope": true,
                            "out_of_scope": true,
                            "steps": true,
                            "affected_files": true,
                            "validation": true,
                            "definition_of_done": true,
                            "dependencies": {
                              "type": "array",
                              "uniqueItems": true,
                              "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}-[0-9]+$"}
                            },
                            "estimate_hours": true,
                            "requirements": true,
                            "parent_acceptance_criteria_refs": true,
                            "content_language": true,
                            "acceptance_criteria_storage": true,
                            "acceptance_criteria": true
                          }
                        }
                      },
                      "traceability": true,
                      "traceability_complete": {"const": true}
                    },
                    "required": [
                      "target_completion_date_evidence",
                      "canonical_spec",
                      "requirements",
                      "acceptance_criteria",
                      "traceability"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "selected",
          "displaced_work",
          "trade_off",
          "deadline_impact"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "selected": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^DLV-[0-9]{8}-[0-9]{2}$"
            }
          },
          "displaced_work": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^DLV-[0-9]{8}-[0-9]{2}$"
            }
          },
          "trade_off": {
            "type": "string",
            "minLength": 1
          },
          "deadline_impact": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "recommendation": {
      "type": [
        "string",
        "null"
      ]
    },
    "displaced_work": {
      "type": "array"
    },
    "page_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership",
        "current_version",
        "operation"
      ],
      "properties": {
        "ownership": {
          "enum": [
            "jiraman-managed",
            "mixed",
            "human-owned"
          ]
        },
        "current_version": {
          "type": [
            "string",
            "integer"
          ]
        },
        "operation": {
          "enum": [
            "page.create",
            "page.update",
            "page.section-update",
            "page.comment",
            "no-action"
          ]
        }
      }
    }
  },
  "definitions": {
    "traceability-map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    }
  }
}
