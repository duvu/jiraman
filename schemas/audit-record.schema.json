{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "group_id", "action_id", "approved_by", "approved_at", "started_at", "ended_at", "tool_result", "created_ids", "before_state", "after_state", "verification", "failure", "rollback_guidance"],
  "properties": {
    "schema_version": {"const": 5},
    "workflow_id": {"type": "string", "minLength": 1},
    "group_id": {"type": "string", "pattern": "^PMG-[0-9]{8}-[0-9]{2}$"},
    "action_id": {"type": "string", "pattern": "^PMA-[0-9]{8}-[0-9]{2}$"},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "tool_result": {"enum": ["success", "failure", "permission-error"]},
    "created_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "before_state": {"type": "object"},
    "after_state": {"type": "object"},
    "verification": {"enum": ["passed", "failed", "not-verified"]},
    "failure": {"type": ["object", "null"]},
    "rollback_guidance": {"type": "string", "minLength": 1}
  }
}
