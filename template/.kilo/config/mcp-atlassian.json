  "profiles": {
    "read-only-analysis": {
      "allow": [
        "read"
      ],
      "deny": [
        "write",
        "destructive"
      ]
    },
    "report-proposal": {
      "allow": [
        "read"
      ],
      "deny": [
        "write",
        "destructive"
      ]
    },
    "approved-write": {
      "allow": [
        "read",
        "write"
      ],
      "write_permission": "ask",
      "deny": [
        "destructive"
      ]
    }
